<?php
// R-172: this page runs on EVERY Unraid page load, so it runs no process and reads no file.
// Whether the home or agent storage sits on the array is asked from the plugin (the action
// get_array_stop_impact) when the person presses "Stop array".
?>
<script>
/**
 * AI CLI Agents: Global Array Stop Interceptor
 * Warns the user about active sessions AND storage paths on the array before stopping.
 */
(function() {
    var homeOnArray = false;
    var agentOnArray = false;
    var homePath = '';
    var agentPath = '';

    // #592: workspaces.json is writable by an agent process, so every field that
    // goes into the dialog HTML is escaped here. Never put a raw field in it.
    function esc(v) {
        return String(v == null ? '' : v).replace(/[&<>"']/g, function(c) {
            return {'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'}[c];
        });
    }

    document.addEventListener('DOMContentLoaded', function() {
        const checkAndIntercept = () => {
            const originalStopArray = window.stopArray;

            if (typeof originalStopArray === 'function' && !originalStopArray._aicli_wrapped) {
                console.log('[AICli] Global Array Stop Interceptor Active');

                window.stopArray = async function(form) {
                    let sessions = [];
                    try {
                        const resp = await fetch('/plugins/unraid-aicliagents/AICliAjax.php?action=get_workspaces&csrf_token=' + encodeURIComponent(window.csrf_token || ''));
                        const data = await resp.json();
                        sessions = (data && data.sessions) ? data.sessions : [];
                    } catch (e) {}
                    // R-172: ask now (not at page load) which storage sits on the array.
                    // If the answer fails, the dialog still lists the sessions.
                    try {
                        const resp2 = await fetch('/plugins/unraid-aicliagents/AICliAjax.php?action=get_array_stop_impact&csrf_token=' + encodeURIComponent(window.csrf_token || ''));
                        const impact = await resp2.json();
                        if (impact && impact.status === 'ok') {
                            homeOnArray = !!impact.homeOnArray;
                            agentOnArray = !!impact.agentOnArray;
                            homePath = impact.homePath || '';
                            agentPath = impact.agentPath || '';
                        }
                    } catch (e) {}

                    // Filter for sessions with workspace paths on array/pool
                    const arraySessions = sessions.filter(function(s) {
                        var path = (s.path || '').replace(/\/+/g, '/');
                        return path.startsWith('/mnt/') && !path.startsWith('/mnt/disks/') && !path.startsWith('/mnt/remotes/');
                    });

                    var hasImpact = (arraySessions.length > 0 || homeOnArray || agentOnArray);

                    if (!hasImpact) {
                        // Nothing affected — pass through to default Unraid behavior
                        originalStopArray(form);
                        return;
                    }

                    // Build impact summary
                    var bodyHtml = '';

                    // Storage warnings
                    if (homeOnArray || agentOnArray) {
                        bodyHtml += '<div style="margin-bottom:12px;text-align:left;">';
                        bodyHtml += '<div style="font-weight:600;margin-bottom:6px;">Storage on array:</div>';
                        if (homeOnArray) {
                            bodyHtml += '<div style="display:flex;align-items:center;gap:8px;padding:4px 8px;background:rgba(234,179,8,0.1);border-radius:4px;margin:2px 0;font-size:12px;">'
                                + '<i class="fa fa-home" style="color:#eab308;width:16px;text-align:center;"></i>'
                                + '<span>Home Storage: <span style="font-family:monospace;font-size:11px;opacity:0.7;">' + esc(homePath) + '</span></span>'
                                + '</div>';
                        }
                        if (agentOnArray) {
                            bodyHtml += '<div style="display:flex;align-items:center;gap:8px;padding:4px 8px;background:rgba(234,179,8,0.1);border-radius:4px;margin:2px 0;font-size:12px;">'
                                + '<i class="fa fa-cube" style="color:#eab308;width:16px;text-align:center;"></i>'
                                + '<span>Agent Storage: <span style="font-family:monospace;font-size:11px;opacity:0.7;">' + esc(agentPath) + '</span></span>'
                                + '</div>';
                        }
                        bodyHtml += '<div style="font-size:11px;opacity:0.6;margin-top:4px;">A temporary home will be used while the array is stopped. Any changes made in emergency mode will be discarded when the array restarts.</div>';
                        bodyHtml += '</div>';
                    }

                    // Session list
                    if (arraySessions.length > 0) {
                        bodyHtml += '<div style="text-align:left;">';
                        bodyHtml += '<div style="font-weight:600;margin-bottom:6px;">' + arraySessions.length + ' session(s) with workspaces on the array:</div>';
                        bodyHtml += '<div style="max-height:150px;overflow-y:auto;">';
                        arraySessions.forEach(function(s) {
                            bodyHtml += '<div style="display:flex;align-items:center;gap:8px;padding:4px 8px;background:rgba(0,0,0,0.05);border-radius:4px;margin:2px 0;font-size:12px;">'
                                + '<strong style="color:#ff8c00;min-width:80px;">' + esc(s.agentId || 'unknown') + '</strong>'
                                + '<span style="opacity:0.7;font-family:monospace;font-size:11px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">' + esc(s.path || '') + '</span>'
                                + '</div>';
                        });
                        bodyHtml += '</div>';
                        bodyHtml += '<div style="font-size:11px;opacity:0.6;margin-top:4px;">These sessions will be terminated to prevent unmount locks.</div>';
                        bodyHtml += '</div>';
                    }

                    if (typeof window.swal === 'function') {
                        // Epic #307: 44 px buttons at phone size. The rule is
                        // scoped to a body class that is set only while THIS
                        // dialog is open, so Unraid's own dialogs keep their style.
                        if (!document.getElementById('aicli-array-stop-swal-style')) {
                            var st = document.createElement('style');
                            st.id = 'aicli-array-stop-swal-style';
                            st.textContent = '@media (max-width:600px){'
                                + 'body.aicli-array-stop-swal .sweet-alert .sa-button-container button,'
                                + 'body.aicli-array-stop-swal .sweet-alert .sa-confirm-button-container button'
                                + '{min-height:44px !important;min-width:44px !important;box-sizing:border-box !important;}'
                                + 'body.aicli-array-stop-swal .sweet-alert{padding:1.25rem 1rem;}'
                                + 'body.aicli-array-stop-swal .sweet-alert strong{min-width:0 !important;color:inherit !important;font-weight:700;}'
                                + '}';
                            document.head.appendChild(st);
                        }
                        document.body.classList.add('aicli-array-stop-swal');
                        window.swal({
                            title: "AI CLI Agents Affected",
                            text: bodyHtml,
                            type: "warning",
                            html: true,
                            showCancelButton: true,
                            confirmButtonText: "Proceed & Stop Array",
                            cancelButtonText: "Cancel",
                            confirmButtonColor: "#DD6B55"
                        }, function(confirmed) {
                            document.body.classList.remove('aicli-array-stop-swal');
                            if (confirmed) {
                                // #592/#650: no pre-stop eviction call. The action it
                                // used had no handler. The sessions are
                                // closed by the stopping_array event hook, after it
                                // captures their resume ids.
                                if (!$(form).find('input[name="cmdStop"]').length) {
                                    $(form).append('<input type="hidden" name="cmdStop" value="Stop">');
                                }
                                form.submit();
                            }
                        });
                    } else {
                        if (confirm("AI CLI Agents will be affected by stopping the array. Proceed?")) {
                            form.submit();
                        }
                    }
                };

                window.stopArray._aicli_wrapped = true;
            }
        };

        checkAndIntercept();
        setInterval(checkAndIntercept, 5000);
    });
})();
</script>
